{
  "expo": {
    "name": "Dose",
    "slug": "dose-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dose",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0908",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nbv.dose",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0A0908"
        }
      ],
      [
        "expo-system-ui",
        {
          "userInterfaceStyle": "dark"
        }
      ]
    ]
  }
}
